{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Arbromagency-Sato/phantom-mcp-server",
  "description": "PHANTOM ID MCP payment server: agent-to-agent USDC payments on Base.",
  "repository": {
    "url": "https://github.com/Arbromagency-Sato/idphantom-mcp-server",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@phantomid/mcp-server",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "PHANTOM API base URL (default https://pay.idphantom.com)",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "PHANTOM_API_URL"
        },
        {
          "description": "PHANTOM API key for the agent account (create via POST /v1/register — self-serve, $2 USDC on Base)",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "PHANTOM_API_KEY"
        }
      ]
    }
  ]
}
